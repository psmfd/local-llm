// ~/.pi/agent/models.json — oMLX local-inference provider for the Pi coding
// agent. Installed by setup-omlx-m5.sh --configure-pi (rendered from
// templates/pi-models-omlx.json; only written wholesale when the existing
// providers object is empty — otherwise the rendered snippet is left at
// ~/.omlx/pi-provider-snippet.json for a manual merge).
//
// apiKey uses Pi's !command resolution: the key is read from the 0600 file at
// request time and never stored as a literal — this file contains no secret.
//
// compat flags for oMLX's OpenAI-completions endpoint:
//   supportsDeveloperRole: false    — oMLX/Qwen do not accept the 'developer' role
//   supportsReasoningEffort: false  — reasoning_effort is not implemented
//   supportsUsageInStreaming: false — streaming usage stats not guaranteed
//
// Single workhorse model (ADR-009), addressed by its oMLX ALIAS (verified to
// resolve on the installed version):
//   coding-workhorse  GLM-4.7-Flash-6bit  pinned, sole resident model (ADR-010)
// High-fidelity work routes to the cloud frontier, not this provider.
//
// contextWindow is held to 131072 (inside GLM's 202K native context): safe
// concurrency is prefill-activation-bound and falls as context grows (ADR-009
// "The Mark": 10 @ ~16K ctx), so sessions should not fill the native window.
{
  "providers": {
    "omlx": {
      "baseUrl": "http://localhost:__PORT__/v1",
      "api": "openai-completions",
      "apiKey": "!cat __API_KEY_FILE__",
      "authHeader": true,
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "supportsUsageInStreaming": false
      },
      "models": [
        {
          "id": "__MODEL_ID__",
          "name": "coding-workhorse — GLM-4.7-Flash (local oMLX)",
          "reasoning": false,
          "input": ["text"],
          "contextWindow": __PI_CONTEXT_WINDOW__,
          "maxTokens": __PI_MAX_TOKENS__,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
